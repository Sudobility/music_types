{
  "name": "@sudobility/music_types",
  "version": "0.13.58",
  "description": "TypeScript types and Zod schemas for the ScoreSmith music API - scores, generation contracts, project payloads",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test/fixtures.d.ts",
      "import": "./dist/test/fixtures.js",
      "default": "./dist/test/fixtures.js"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "clean": "rimraf dist",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "keywords": [
    "typescript",
    "types",
    "music",
    "scoresmith",
    "api"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/types": "^1.9.76",
    "immer": "^10.0.0 || ^11.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@sudobility/types": "^1.9.76",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "ajv": "~8.20.0",
    "eslint": "~9.39.5",
    "globals": "~16.5.0",
    "immer": "~11.2.9",
    "rimraf": "~6.1.3",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "~4.1.12",
    "zod": "~4.6.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/music_types.git"
  }
}
